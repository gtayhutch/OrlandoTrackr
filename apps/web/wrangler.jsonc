{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orlandotrackr-test",
  "main": "../../workers/gateway/src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "WAIT_DATA_SOURCE": "sample" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "containers": [
    {
      "class_name": "ParkApi",
      "image": "../../Dockerfile",
      "instance_type": "basic",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "PARK_API", "class_name": "ParkApi" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ParkApi"] }],
  "d1_databases": [
    {
      "binding": "PARK_DATA",
      "database_name": "orlandotrackr-test",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../../workers/gateway/migrations",
      "remote": false,
    },
  ],
  "env": {
    "staging": {
      "name": "orlandotrackr-staging",
      "account_id": "9fe808d792b2aa8f095351f40b89c3eb",
      "vars": { "WAIT_DATA_SOURCE": "sample", "SHOW_STAGING_LABEL": "true" },
      "containers": [
        {
          "name": "orlandotrackr-staging-parkapi",
          "class_name": "ParkApi",
          "image": "../../Dockerfile",
          "instance_type": "basic",
          "max_instances": 1,
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "PARK_API", "class_name": "ParkApi" }],
      },
      "d1_databases": [
        {
          "binding": "PARK_DATA",
          "database_name": "orlandotrackr-staging",
          "database_id": "504f9cf8-a147-48d4-bcaf-d6c7c4923970",
          "migrations_dir": "../../workers/gateway/migrations",
          "remote": false,
        },
      ],
    },
    "production": {
      "name": "orlandotrackr-production",
      "account_id": "9fe808d792b2aa8f095351f40b89c3eb",
      "vars": { "WAIT_DATA_SOURCE": "themeparks-wiki" },
      "containers": [
        {
          "name": "orlandotrackr-production-parkapi",
          "class_name": "ParkApi",
          "image": "../../Dockerfile",
          "instance_type": "basic",
          "max_instances": 1,
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "PARK_API", "class_name": "ParkApi" }],
      },
      "d1_databases": [
        {
          "binding": "PARK_DATA",
          "database_name": "orlandotrackr-production",
          "database_id": "5cdbcff8-0fb6-49ed-aa9c-d723414348f8",
          "migrations_dir": "../../workers/gateway/migrations",
          "remote": false,
        },
      ],
    },
  },
}
