{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orlandotrackr-staging-router",
  "main": "src/index.ts",
  "account_id": "9fe808d792b2aa8f095351f40b89c3eb",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
