{
  "name": "orlandotrackr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "data:local": "wrangler d1 migrations apply orlandotrackr-test --local --config apps/web/wrangler.jsonc && wrangler d1 execute orlandotrackr-test --local --config apps/web/wrangler.jsonc --file workers/gateway/fixtures/sample_waits.sql",
    "format-check": "prettier --check . && node scripts/cargo.mjs fmt --all -- --check",
    "lint": "eslint . && node scripts/cargo.mjs clippy --locked --all-targets -- -D warnings",
    "typecheck": "pnpm --dir apps/web typecheck && node scripts/cargo.mjs check --locked",
    "test": "vitest run --coverage && node scripts/cargo.mjs test --locked",
    "build": "pnpm --dir apps/web build && node scripts/cargo.mjs build --release --locked",
    "test-e2e": "playwright test",
    "verify": "pnpm format-check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test-e2e"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "react-router": "8.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.77.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "5.20261120.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.0.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsc-rs": "0.8.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
